---
import Base from '../layouts/Base.astro';
import { U, LINKS, problems, features, video, how, faqs, posts, postsMarquee } from '../data';
---
<Base>
  <!-- Hero -->
  <section class="hero"><div class="w">
    <div class="blob" style="width:360px;height:360px;background:var(--yellow);top:-80px;right:10%"></div>
    <div class="blob" style="width:220px;height:220px;background:var(--lav);bottom:-40px;left:-60px"></div>
    <div>
      <h1>Quiz score <em class="squig">unlocks<svg viewBox="0 0 160 14"><path d="M2 10 C 40 2, 120 2, 158 10" stroke="currentColor" stroke-width="3" fill="none" stroke-linecap="round"/></svg></em><br/>entertainment apps!</h1>
      <p class="lead">Children love rewards! They gain access to locked apps for a set time when they pass their quizzes.</p>
      <a class="btn" href={LINKS.visit}>Get Applatch Kids &rarr;</a>
      <div class="tag-row"><span>#quiztime</span><span>#unlocked</span><span>#funlearning</span></div>
    </div>
    <div class="hero-shot">
      <img src={U + '2026/04/Features-section-3.png?fit=1320%2C940&ssl=1'} alt="Quiz screen" loading="lazy" />
    </div>
  </div></section>

  <div class="w"><div class="strip">Age appropriate quizzes following National curriculum standard; Maths, English &amp; Science.</div></div>

  <!-- Features -->
  <section id="features"><div class="w">
    <div class="sec-head"><span class="pill">Applatch Kids Features</span><h2>Our <em>interactive</em> features</h2></div>
    <div class="feat-grid">
      {features.map((f, i) => (
        <article class="fcard">
          <div>
            <div class="ic">{i === 0 ? '🧩' : i === 1 ? '📊' : '⭐'}</div>
            <h3>{f.t}</h3>
          </div>
          <p>{f.b}</p>
        </article>
      ))}
    </div>
  </div></section>

  <!-- Did you know / stats -->
  <section><div class="w">
    <div class="stats">
      <span class="pill" style="background:rgba(255,255,255,.15);color:#fff">Did you know?</span>
      <h2>Screen time habits are shaping how kids learn today.</h2>
      <div class="stat-row">
        {problems.map((p) => <div class="stat"><b>{p.t}</b><p>{p.b}</p></div>)}
      </div>
    </div>
  </div></section>

  <!-- Video / explainer -->
  <section class="video-sec"><div class="w">
    <div>
      <span class="pill">Meet Loomey</span>
      <h2>{video.title}</h2>
      <p class="lead">{video.mascot} &mdash; {video.mascotSub} &mdash; hosted by {video.channel}.</p>

    </div>
    <div class="vid-card" id="vid" data-id={video.youtubeId}>
      <img src={U + '2026/04/Hero-section-quiz-screen.png?fit=880%2C627&ssl=1'} alt={video.mascot} loading="lazy" />
      <div class="vid-mascot">{video.mascot}</div>
      <button class="vid-play" aria-label="Play video">&#9654;</button>
    </div>
  </div></section>

  <!-- How it works -->
  <section id="how-it-works"><div class="w">
    <div class="sec-head"><span class="pill">How it Works</span><h2>{how.heading}</h2></div>
    <div class="how-grid">
      {how.steps.map((h) => (
        <figure class="hstep">
          <span class="step">{h.step}</span>
          <img src={U + h.img} alt="" loading="lazy" />
          <figcaption>{h.t}</figcaption>
        </figure>
      ))}
    </div>
  </div></section>

  <!-- FAQ -->
  <section class="faq"><div class="w" style="max-width:760px">
    <div class="sec-head"><span class="pill">FAQs</span><h2>Any questions? Check out the FAQs</h2></div>
    {faqs.map(([q, a], i) => (
      <details open={i === 0}>
        <summary>{q}</summary>
        {a.split('\n\n').map((para) => <p>{para}</p>)}
      </details>
    ))}
    <p style="margin-top:20px">Still have questions? <a href="https://applatch.com/applatchkids/contacts-us/"><b>Contact us now</b></a></p>
  </div></section>

  <!-- Blog -->
  <section><div class="w">
    <div class="sec-head"><span class="pill">From the Blog</span><h2>Featured blog posts</h2></div>
    <div class="blog-grid">{posts.map((p) => <a href={p.href}><small>{p.d}</small><h3>{p.t}</h3></a>)}</div>
    <div class="marq" aria-label="More blog posts"><div class="track">
      {[...postsMarquee, ...postsMarquee].map((p) => (
        <a class="marq-card" href={p.href}><small>{p.d}</small><span>{p.t}</span></a>
      ))}
    </div></div>
  </div></section>

  <div class="w" style="padding-bottom:90px"><div class="cta">
    <h2>Subscribe to our newsletter to stay informed about the latest updates</h2>
    <form id="news"><input type="email" required placeholder="Your email address" aria-label="Email address" /><button class="btn">Subscribe</button></form>
  </div></div>
</Base>

<script>
  const v = document.getElementById('vid')!;
  v.querySelector('button')!.addEventListener('click', () => {
    v.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${v.dataset.id}?autoplay=1" title="Applatch Kids explainer video" allow="autoplay; encrypted-media; fullscreen" allowfullscreen></iframe>`;
  });
  const news = document.getElementById('news')!;
  news.addEventListener('submit', (e) => { e.preventDefault(); news.innerHTML = '<b>Thanks! Check your inbox.</b>'; });
</script>
