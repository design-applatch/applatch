---
import Base from '../layouts/Base.astro';
import Quiz from '../components/Quiz.astro';
import { U, LINKS, problems, features, how, screens, faqs, price, posts, subjects, proof } from '../data';
const dots = ['#E2714B', '#2F6FED', '#E8A33D', '#1F5C3F'];
const YT = '1ZHp7vDr8lM';
---
<Base>
  <!-- 1. Hero -->
  <section class="hero"><div class="w two">
    <div>
      <span class="badge">Ages 6–14 \u00B7 Curriculum-aligned quizzes</span>
      <h1 class="scatter" data-scatter>Where screen time <em class="underline">earns<svg viewBox="0 0 160 14"><path d="M2 10 C 40 2, 120 2, 158 10" stroke="currentColor" stroke-width="3" fill="none" stroke-linecap="round"/></svg></em> its keep</h1>
      <p class="lead">A quiz-first world where kids unlock their favourite entertainment apps by passing short Maths, English and Science quizzes — and parents get a weekly report on how they're doing.</p>
      <p class="row">
        <a class="btn" href={LINKS.visit}>Get Applatch Kids</a>
        <a class="btn y icon" href="#features"><i>▶</i>See how it works</a>
      </p>
      <div class="proof">
        <div class="stack">{proof.people.map((p, i) => <span style={`background:${dots[i % dots.length]}`}>{p}</span>)}</div>
        <div><b>{proof.stat}</b><small>{proof.sub}</small></div>
      </div>
    </div>
    <div class="collage">
      <div style="background:#E2714B1a"><img src={U + '2026/04/Features-section-3.png?fit=1320%2C940&ssl=1'} alt="Quiz screen" loading="lazy" /></div>
      <div style="background:#2F6FED1a"><img src={U + '2026/07/Group-1000003136.png?fit=1062%2C788&ssl=1'} alt="Weekly report" loading="lazy" /></div>
      <div style="background:#E8A33D1a"><img src={U + '2026/07/Group-1000003136-1.png?fit=1062%2C788&ssl=1'} alt="Pops rewards" loading="lazy" /></div>
      <div style="background:#1F5C3F1a"><img src={U + '2026/04/Hero-section-quiz-screen.png?fit=880%2C627&ssl=1'} alt="App home" loading="lazy" /></div>
    </div>
  </div></section>

  <!-- Icon strip -->
  <div class="w"><div class="strip">
    {subjects.map((s) => <div class="it"><i>{s.icon}</i><div><b>{s.t}</b><small>{s.s}</small></div></div>)}
  </div></div>

  <!-- Try the quiz -->
  <section class="trydemo"><div class="w two">
    <div><p class="tag">Play this short quiz</p><h2 class="sec" style="margin-bottom:14px">Try it yourself</h2>
    <p class="lead">Three quick questions, just like the real app. Score well and the locked apps unlock.</p></div>
    <Quiz />
  </div></section>

  <!-- 2. Video -->
  <section class="video"><div class="w">
    <div class="vid" id="vid" data-id={YT}>
      <img src={U + '2026/04/Hero-section-quiz-screen.png?fit=880%2C627&ssl=1'} alt="Applatch Kids quiz screen" width="880" height="627" loading="lazy" />
      <button aria-label="Play video">▶</button>
    </div>
  </div></section>

  <!-- 3. Problems: stacked cards -->
  <section class="probs"><div class="w">
    <h2 class="sec">Screen time is winning. Learning is losing.</h2>
    <div class="stack">
      {problems.map((p, i) => (
        <article class="pcard" style={`--i:${i}`}>
          <h3>{p.t}</h3><p>{p.b}</p><small>{p.s}</small>
        </article>
      ))}
    </div>
  </div></section>

  <!-- 4. Pinned scroll word -->
  <section class="pin" id="pin"><div class="st"><div>
    <h2 class="pinword">Learn <em>then</em> Play</h2>
    <p id="pinp">Applatch Kids locks entertainment apps until a quiz is passed, so screen time turns into learning time.</p>
  </div></div></section>

  <!-- 5. Features -->
  <section id="features" class="feats"><div class="w">
    <p class="tag">Inside the app</p>
    <h2 class="sec">Five ways it keeps them learning</h2>
    {features.map((f) => (
      <article class="feat">
        <div class="ft">
          <h3>{f.t}</h3><p>{f.b}</p>
          {f.stores && <p class="row">
            <a href={LINKS.ios}><img src={'https://applatch.com/applatchkids/wp-content/uploads/2022/02/appstore-dark.svg'} alt="Download on the App Store" height="44" /></a>
            <a href={LINKS.android}><img src={'https://applatch.com/applatchkids/wp-content/uploads/2022/02/googleplay-dark.svg'} alt="Get it on Google Play" height="44" /></a>
          </p>}
          {f.cta && <p><a class="btn" href={LINKS[f.cta[1] as keyof typeof LINKS]}>{f.cta[0]}</a></p>}
        </div>
        <div class={`fi ${f.tall ? 'tall' : ''}`}><img src={U + f.img} alt={f.t} width={f.w} height={f.h} loading="lazy" /></div>
      </article>
    ))}
  </div></section>

  <!-- 6. How it works -->
  <section id="how-it-works" class="how"><div class="w">
    <h2 class="sec">How it works</h2>
    <p class="sub">Quiz score unlocks entertainment apps and children are kept safe online.</p>
    <div class="cards">
      {how.map((h) => (
        <figure class="hc" tabindex="0">
          <img src={U + h.img} alt="" loading="lazy" /><figcaption>{h.t}</figcaption>
        </figure>
      ))}
    </div>
  </div>
  <div class="marq" aria-label="App screens"><div class="track">
    {[...screens, ...screens].map((s) => <img src={U + s} alt="" width="328" loading="lazy" />)}
  </div></div></section>

  <!-- 7. Pricing -->
  <section id="pricing" class="price"><div class="w">
    <h2 class="sec">Our pricing works for everybody</h2>
    <div class="tg"><button class="on" data-p="m">Per month</button><button data-p="y">Per year</button></div>
    <div class="pc">
      <div class="n" id="pn">{price.month}</div><p id="pl">per month</p>
      <p class="save" id="ps" style="visibility:hidden">{price.save}</p>
      <ul>{price.perks.map((p) => <li>{p}</li>)}</ul>
      <a class="btn" href={LINKS.visit}>Get Applatch Kids</a>
    </div>
  </div></section>

  <!-- 8. FAQ -->
  <section class="faq"><div class="w narrow">
    <h2 class="sec">Any questions? Check out the FAQs</h2>
    {faqs.map(([q, a], i) => <details open={i === 0}><summary>{q}</summary><p>{a}</p></details>)}
    <p>Still have unanswered questions? <a href="https://applatch.com/applatchkids/contacts-us/"><b>Contact us now</b></a></p>
  </div></section>

  <!-- 9. Blog -->
  <section class="blog"><div class="w">
    <h2 class="sec">Featured blog posts</h2>
    <div class="posts">{posts.map((p) => <a href={p.href}><small>{p.d}</small><h3>{p.t}</h3></a>)}</div>
    <p><a class="btn" href="https://applatch.com/applatchkids/blog/">View all posts</a></p>
  </div></section>

  <!-- 10. Closing CTA + newsletter -->
  <section class="w"><div class="cta">
    <h2>Let’s make screen time count</h2>
    <p>Subscribe to stay informed about the latest updates.</p>
    <p><a class="btn" href={LINKS.visit}>Get Applatch Kids</a></p>
    <form id="news"><input type="email" required placeholder="Your email address" aria-label="Email address" /><button class="btn">Subscribe</button></form>
  </div></section>
</Base>

<script>
  // Hero headline: letters start scattered, then gather (one page-load moment)
  document.querySelectorAll<HTMLElement>('[data-scatter]').forEach((el) => {
    const text = el.textContent || ''; el.setAttribute('aria-label', text); el.textContent = '';
    text.split(' ').forEach((w) => {
      const word = document.createElement('span'); word.className = 'wd';
      [...w].forEach((c) => {
        const l = document.createElement('span'); l.textContent = c; l.setAttribute('aria-hidden', 'true'); l.className = 'ch';
        l.style.transform = `translate(${(Math.random() - .5) * 240}px,${(Math.random() - .5) * 200}px) rotate(${(Math.random() - .5) * 120}deg)`; l.style.opacity = '0';
        word.appendChild(l);
      });
      el.appendChild(word); el.appendChild(document.createTextNode(' '));
    });
    requestAnimationFrame(() => el.querySelectorAll<HTMLElement>('.ch').forEach((l, i) => {
      l.style.transition = `transform .9s cubic-bezier(.2,1.3,.4,1) ${i * 25}ms, opacity .5s ${i * 25}ms`;
      l.style.transform = 'none'; l.style.opacity = '1';
    }));
  });
  // Pinned word: letter-spacing tightens with scroll
  const pin = document.getElementById('pin')!, word = pin.querySelector<HTMLElement>('.pinword')!;
  const onScroll = () => {
    const r = pin.getBoundingClientRect(), p = Math.min(1, Math.max(0, -r.top / (r.height - innerHeight)));
    word.style.letterSpacing = `${0.5 - 0.53 * Math.min(1, p * 1.6)}em`;
    pin.style.setProperty('--o', String(Math.max(0, (p - 0.55) * 3)));
  };
  addEventListener('scroll', onScroll, { passive: true }); onScroll();
  // Video facade: load YouTube only on click
  const v = document.getElementById('vid')!;
  v.querySelector('button')!.onclick = () => {
    v.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${v.dataset.id}?autoplay=1" title="Applatch Kids video" allow="autoplay; encrypted-media; fullscreen" allowfullscreen></iframe>`;
  };
  // Pricing toggle
  const $ = (id: string) => document.getElementById(id)!;
  document.querySelectorAll<HTMLButtonElement>('.tg button').forEach((b) => (b.onclick = () => {
    document.querySelectorAll('.tg button').forEach((x) => x.classList.remove('on')); b.classList.add('on');
    const y = b.dataset.p === 'y';
    $('pn').textContent = y ? '£39.99' : '£3.99'; $('pl').textContent = y ? 'per year' : 'per month'; $('ps').style.visibility = y ? 'visible' : 'hidden';
  }));
  // Newsletter: TODO connect to your email provider
  $('news').onsubmit = (e) => { e.preventDefault(); $('news').innerHTML = '<b>Thanks! Check your inbox.</b>'; };
</script>
